# PostgreSQL / API
DATABASE_URL=postgresql+psycopg://resume:replace-with-a-local-dev-password@localhost:5432/resume_intelligence
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Local-only, fail-closed retrieval authorization. Replace with identity-provider
# claims in production; do not commit real tokens.
RETRIEVAL_AUTH_TOKENS_JSON={"replace-with-a-long-random-local-token":["demo-tenant"]}

# LangGraph checkpoint serialization is strict by default in this project.
LANGGRAPH_STRICT_MSGPACK=true

# Docker Compose defaults (only needed to override docker-compose.yml values)
POSTGRES_DB=resume_intelligence
POSTGRES_USER=resume
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_PORT=5432

# Existing optional Gemini enrichment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Integration tests: use an isolated database, never a shared production database.
TEST_DATABASE_URL=postgresql+psycopg://resume:replace-with-a-local-dev-password@localhost:5432/resume_intelligence_test

# Optional trace cost estimate inputs. Do not add provider secrets or pricing
# commitments to source control. Leave blank when the active provider rate is unknown.
GENAI_INPUT_USD_PER_MILLION_TOKENS=
GENAI_OUTPUT_USD_PER_MILLION_TOKENS=
