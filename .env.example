# Copy to .env (ignored by Git) and replace every placeholder. Never commit real values.

# --- PostgreSQL / Docker Compose ---------------------------------------------
POSTGRES_DB=resume_intelligence
POSTGRES_USER=resume
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_PORT=5432
API_PORT=8000
STREAMLIT_PORT=8501

# Used by the API/Alembic when running outside Compose (Compose builds its own URL).
DATABASE_URL=postgresql+psycopg://resume:replace-with-a-local-dev-password@localhost:5432/resume_intelligence
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Development authorization (NOT production authentication) ---------------
# Token -> permitted tenants. Legacy list form grants all roles; the object form
# narrows roles to any of: reader, editor (upload/delete), reviewer (approve or
# reject AI-generated notes). Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RETRIEVAL_AUTH_TOKENS_JSON={"replace-with-a-long-random-local-token":["demo-tenant"]}

# Streamlit server-side API credentials (never shown in the browser). The token
# must appear in RETRIEVAL_AUTH_TOKENS_JSON with access to API_TENANT_ID.
# Outside Compose also set API_BASE_URL=http://localhost:8000; leave it unset for Standalone mode.
API_TENANT_ID=demo-tenant
API_BEARER_TOKEN=replace-with-a-long-random-local-token

# --- Grounded generation (optional; fails closed) ------------------------------
# Generation runs only when GEMINI_API_KEY is set AND the tenant has a policy entry
# documenting provider, purpose, and retention. Use synthetic resumes for demos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GENERATION_TENANT_POLICY_JSON={}
# Example: {"demo-tenant":{"provider":"gemini","purpose":"recruiter review assistance with synthetic demo data","retention":"provider default; synthetic data only"}}

# Optional original per-candidate Gemini enrichment in Candidate Ranking (Compose streamlit service).
STREAMLIT_GEMINI_API_KEY=

# LangGraph checkpoint serialization is strict by default in this project.
LANGGRAPH_STRICT_MSGPACK=true

# --- Tests ---------------------------------------------------------------------
# Isolated database only; the integration suite truncates its tables.
TEST_DATABASE_URL=postgresql+psycopg://resume:replace-with-a-local-dev-password@localhost:5432/resume_intelligence_test

# Optional trace cost estimate inputs. Leave blank when the active provider rate is unknown.
GENAI_INPUT_USD_PER_MILLION_TOKENS=
GENAI_OUTPUT_USD_PER_MILLION_TOKENS=
